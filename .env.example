# 🌐 সার্ভার পোর্ট (Render নিজে থেকে PORT দিয়ে থাকে)
PORT=3000

# 🤖 Google Gemini API ক্রেডেনশিয়াল (https://aistudio.google.com থেকে সংগ্রহ করুন)
GEMINI_API_KEY=AIzaSyYourActualGoogleGeminiApiKeyHere

# ⚡ Gemini মডেল কনফিগারেশন (অফিশিয়াল হাই-স্পিড মডেল)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# ⏱️ AI টাইমআউট (মিলিসেকেন্ডে - ফাস্ট রেসপন্সের জন্য ডিফল্ট ৮ সেকেন্ড)
AI_TIMEOUT_MS=8000

# 👑 অ্যাডমিন হোয়াটসঅ্যাপ নম্বর (যেখানে সফল অর্ডারের নোটিফিকেশন যাবে)
ADMIN_PHONE=8801404277094

# 🔒 অ্যাডমিন ড্যাশবোর্ড সিকিউরিটি টোকেন (নিরাপদ পাসওয়ার্ড ব্যবহার করুন)
DASHBOARD_TOKEN=TechXZoneSecretDashboardAuthKey2026

# 🛒 TechXZone ওয়েবসাইট এবং PHP মাস্টার এপিআই বেস ইউআরএল
SITE_BASE_URL=https://techxzone.shop

# 🔄 ক্যাটালগ অটো-রিফ্রেশ বিরতি (মিলিসেকেন্ডে - প্রতি ১৫ মিনিট পর পর)
CATALOG_REFRESH_MS=900000

# 💾 হোয়াটসঅ্যাপ সেশন ব্যাকআপ ইন্টারভাল (মিলিসেকেন্ডে - প্রতি ৫ মিনিট)
SESSION_BACKUP_INTERVAL_MS=300000
